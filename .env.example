# Copy to .env and fill in whichever providers you have.
# Every key is optional: without one, that module runs in clearly-labelled DEMO mode.

PORT=3000

# Claude (AI visibility, content writer, review replies, action plan narrative).
# Also picked up from `ant auth login` profiles if unset.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Google Places API (New) - live map/local-pack rankings + GBP data. Enable "Places API (New)".
GOOGLE_PLACES_API_KEY=

# DataForSEO - Google Maps SERP by GPS coordinate (most accurate grid), organic SERPs,
# AI Overview detection, keyword volumes/ideas, backlinks. https://dataforseo.com
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Max pages the site-audit crawler fetches per run.
AUDIT_MAX_PAGES=60

# Public URL of this app (used in review-request links and shared report links).
PUBLIC_URL=http://localhost:3000

# More AI engines for AI Visibility (each optional; Claude is used if set above).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar

# Email (review requests, alerts, scheduled reports) via Resend - https://resend.com
RESEND_API_KEY=
EMAIL_FROM=Your Business <reviews@yourdomain.com>

# SMS review requests via Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+15555550100

# Google Search Console + GA4 (Traffic Insights). Path to a service-account JSON key;
# add the service account's email as a user on your GSC property and GA4 property.
GOOGLE_SERVICE_ACCOUNT_FILE=

# Optional: PageSpeed Insights API key for Core Web Vitals in Site Audit (works keyless at low volume).
PAGESPEED_API_KEY=

# Password-protect the app (browser login prompt, any username). Strongly recommended if hosted publicly.
APP_PASSWORD=
